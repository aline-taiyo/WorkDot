{
  "manifest_version": 3,
  "name": "WorkDot DaouOffice Bridge",
  "version": "2.0.5",
  "description": "WorkDot 윈도우 위젯과 크롬 다우오피스 로그인 세션을 연결하는 브릿지 확장프로그램",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "WorkDot DaouOffice Bridge",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://alinestudio.daouoffice.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://alinestudio.daouoffice.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
