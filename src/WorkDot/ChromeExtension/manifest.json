{
  "manifest_version": 3,
  "name": "WorkDot DaouOffice Bridge",
  "version": "2.0.0",
  "description": "WorkDot 윈도우 위젯과 크롬 다우오피스 로그인 세션을 연결하는 브릿지 확장프로그램",
  "permissions": [
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://alinestudio.daouoffice.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://alinestudio.daouoffice.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
