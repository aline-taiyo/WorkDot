<Window x:Class="WorkDot.ConfirmClockOutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="퇴근 확인"
        Width="210" Height="106"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown">

    <Border Background="#09090B"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="퇴근 할래요?"
                       FontFamily="{StaticResource SansFont}"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="#FAFAFA"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,2,0,10"/>

            <UniformGrid Grid.Row="1" Columns="2">
                <Button x:Name="YesButton"
                        Style="{StaticResource ModernActionBtnStyle}"
                        Content="Y"
                        Background="#EF4444"
                        BorderBrush="#EF4444"
                        Foreground="#FAFAFA"
                        FontSize="12.5"
                        FontWeight="Bold"
                        Padding="0,6"
                        Margin="0,0,4,0"
                        Click="OnYesClick"/>

                <Button x:Name="NoButton"
                        Style="{StaticResource ModernActionBtnStyle}"
                        Content="N"
                        Background="#18181B"
                        BorderBrush="#27272A"
                        Foreground="#A1A1AA"
                        FontSize="12.5"
                        FontWeight="Bold"
                        Padding="0,6"
                        Margin="4,0,0,0"
                        Click="OnNoClick"/>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
