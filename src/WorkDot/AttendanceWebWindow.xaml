<Window x:Class="WorkDot.AttendanceWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="다우오피스"
        Icon="pack://application:,,,/WorkDot;component/Assets/Icons/workdot.ico"
        Width="1120" Height="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        Background="#09090B"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Toolbar -->
        <Border Grid.Row="0"
                Background="#09090B"
                BorderBrush="#27272A"
                BorderThickness="0,0,0,1"
                Padding="12,0,12,0">
            <DockPanel LastChildFill="True">
                <!-- Left: Navigation Buttons (뒤로 | 앞으로 | 홈 | 새로고침) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernIconBtnStyle}"
                            Click="OnBackClick"
                            ToolTip="뒤로"
                            Margin="0,0,2,0">
                        <Path Data="{StaticResource GeomBack}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12" Height="12"
                              Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource ModernIconBtnStyle}"
                            Click="OnForwardClick"
                            ToolTip="앞으로"
                            Margin="0,0,2,0">
                        <Path Data="{StaticResource GeomForward}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12" Height="12"
                              Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource ModernIconBtnStyle}"
                            Click="OnGoHomeClick"
                            ToolTip="홈"
                            Margin="0,0,2,0">
                        <Path Data="{StaticResource GeomHome}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="13" Height="13"
                              Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource ModernIconBtnStyle}"
                            Click="OnReloadClick"
                            ToolTip="새로고침"
                            Margin="0,0,8,0">
                        <Path Data="{StaticResource GeomRefresh}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12" Height="12"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- URL Bar (Selectable & Copy/Pasteable) -->
                <Border Background="#121215"
                        BorderBrush="#27272A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,8"
                        Padding="10,0">
                    <TextBox x:Name="UrlText"
                             Text="https://alinestudio.daouoffice.com/ehr/app/attend/my-attendance-status"
                             FontFamily="{StaticResource SansFont}"
                             Foreground="#A1A1AA"
                             CaretBrush="#FAFAFA"
                             SelectionBrush="#3F3F46"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="11.5"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Cursor="IBeam"
                             KeyDown="OnUrlTextKeyDown"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- WebView2 Content -->
        <wv2:WebView2 x:Name="PortalWebView" Grid.Row="1" DefaultBackgroundColor="White"/>
    </Grid>
</Window>
