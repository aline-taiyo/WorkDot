<Window x:Class="WorkDot.AttendanceWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="다우오피스 근태 현황"
        Width="1120" Height="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="#09090B"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#27272A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- shadcn/ui Style Header Toolbar -->
            <Border Grid.Row="0"
                    Background="#09090B"
                    BorderBrush="#27272A"
                    BorderThickness="0,0,0,1"
                    Padding="12,0,10,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <!-- Left: Navigation & Title -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernIconBtnStyle}"
                                Click="OnBackClick"
                                ToolTip="뒤로"
                                Margin="0,0,2,0">
                            <Path Data="{StaticResource GeomBack}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource ModernIconBtnStyle}"
                                Click="OnReloadClick"
                                ToolTip="새로고침"
                                Margin="0,0,10,0">
                            <Path Data="{StaticResource GeomRefresh}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </Button>

                        <TextBlock Text="다우오피스 근태"
                                   FontFamily="{StaticResource SansFont}"
                                   Foreground="#FAFAFA"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Actions & Close -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernActionBtnStyle}"
                                Content="팝업 닫기"
                                Background="#18181B"
                                BorderBrush="#27272A"
                                Foreground="#E4E4E7"
                                Click="OnDismissPopupsClick"
                                Margin="0,0,6,0"/>

                        <Button Style="{StaticResource ModernActionBtnStyle}"
                                Content="근태 홈"
                                Background="#18181B"
                                BorderBrush="#27272A"
                                Foreground="#E4E4E7"
                                Click="OnGoHomeClick"
                                Margin="0,0,6,0"/>

                        <Button Style="{StaticResource ModernActionBtnStyle}"
                                Content="동기화 및 닫기"
                                Background="#FAFAFA"
                                BorderBrush="#FAFAFA"
                                Foreground="#09090B"
                                Click="OnSyncAndCloseClick"
                                Margin="0,0,8,0"/>

                        <Button Style="{StaticResource WindowCloseBtnStyle}"
                                Click="OnSyncAndCloseClick"/>
                    </StackPanel>

                    <!-- Center: URL Bar -->
                    <Border Background="#121215"
                            BorderBrush="#27272A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="12,8"
                            Padding="10,0">
                        <TextBlock x:Name="UrlText"
                                   Text="https://alinestudio.daouoffice.com/ehr/app/attend/my-attendance-status"
                                   FontFamily="{StaticResource SansFont}"
                                   Foreground="#71717A"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- WebView2 Content -->
            <wv2:WebView2 x:Name="PortalWebView" Grid.Row="1" DefaultBackgroundColor="White"/>
        </Grid>
    </Border>
</Window>
