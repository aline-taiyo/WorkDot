<Window x:Class="WorkDot.AttendanceWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WorkDot // DaouOffice Portal"
        Width="1120" Height="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="#0A0A0C"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#2E2E38" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top 2px Signal Line -->
            <Rectangle Grid.Row="0" Fill="#10B981"/>

            <!-- Custom Sharp Technical Header -->
            <Border Grid.Row="1"
                    Background="#0E0E12"
                    BorderBrush="#24242C"
                    BorderThickness="0,0,0,1"
                    Padding="10,0,8,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <!-- Left: Navigation & Title -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernIconBtnStyle}"
                                Click="OnBackClick"
                                ToolTip="뒤로"
                                Margin="0,0,2,0">
                            <Path Data="{StaticResource GeomBack}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3"
                                  Width="11" Height="11"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource ModernIconBtnStyle}"
                                Click="OnReloadClick"
                                ToolTip="새로고침"
                                Margin="0,0,10,0">
                            <Path Data="{StaticResource GeomRefresh}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3"
                                  Width="11" Height="11"
                                  Stretch="Uniform"/>
                        </Button>

                        <Rectangle Width="6" Height="6" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="WORKDOT // PORTAL"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="#FAFAFA"
                                   FontWeight="Bold"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Actions & Close -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernActionBtnStyle}"
                                Content="팝업 닫기"
                                Background="#141418"
                                BorderBrush="#34343E"
                                Foreground="#D4D4D8"
                                Click="OnDismissPopupsClick"
                                Margin="0,0,6,0"/>

                        <Button Style="{StaticResource ModernActionBtnStyle}"
                                Content="근태 홈"
                                Background="#141418"
                                BorderBrush="#34343E"
                                Foreground="#D4D4D8"
                                Click="OnGoHomeClick"
                                Margin="0,0,6,0"/>

                        <Button Style="{StaticResource ModernActionBtnStyle}"
                                Content="동기화 및 닫기"
                                Background="#1410B981"
                                BorderBrush="#10B981"
                                Foreground="#10B981"
                                Click="OnSyncAndCloseClick"
                                Margin="0,0,8,0"/>

                        <Button Style="{StaticResource WindowCloseBtnStyle}"
                                Click="OnSyncAndCloseClick"/>
                    </StackPanel>

                    <!-- Center: Monospace URL Readout -->
                    <Border Background="#0A0A0C"
                            BorderBrush="#22222A"
                            BorderThickness="1"
                            CornerRadius="0"
                            Margin="12,8"
                            Padding="8,0">
                        <TextBlock x:Name="UrlText"
                                   Text="https://alinestudio.daouoffice.com/ehr/app/attend/my-attendance-status"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="#71717A"
                                   FontSize="10.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- WebView2 Content -->
            <wv2:WebView2 x:Name="PortalWebView" Grid.Row="2" DefaultBackgroundColor="White"/>
        </Grid>
    </Border>
</Window>
