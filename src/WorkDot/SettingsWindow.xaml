<Window x:Class="WorkDot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkDot 설정"
        Width="460" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Window.Resources>
        <!-- 섹션 카드 스타일 -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 컬러 스와치 버튼 스타일 -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}"
                                 Stroke="#E2E8F0"
                                 StrokeThickness="1.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 퀵 배율 버튼 스타일 -->
        <Style x:Key="QuickScaleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 & 버전 배지 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Ellipse Width="12" Height="12" Fill="#10B981" Margin="0,0,8,0"/>
                <TextBlock Text="WorkDot 환경설정" FontSize="17" FontWeight="ExtraBold" Foreground="#F8FAFC"/>
            </StackPanel>

            <Border DockPanel.Dock="Right" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                    CornerRadius="10" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="VersionBadgeText" Text="v1.1.0" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold"/>
            </Border>
        </DockPanel>

        <!-- 중앙 스크롤 설정 영역 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 1. 윈도우 테마 설정 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="🎨 위젯 배경 테마" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,0,0,8"/>
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="ThemeSystemRadio" Content="윈도우 설정 따름" Foreground="#CBD5E1"
                                         Checked="OnThemeRadioChanged" VerticalContentAlignment="Center"/>
                            <RadioButton x:Name="ThemeDarkRadio" Content="다크 모드" Foreground="#CBD5E1"
                                         Checked="OnThemeRadioChanged" VerticalContentAlignment="Center"/>
                            <RadioButton x:Name="ThemeLightRadio" Content="라이트 모드" Foreground="#CBD5E1"
                                         Checked="OnThemeRadioChanged" VerticalContentAlignment="Center"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 2. 출근(근무중) / 퇴근 상태 색상 설정 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="✨ 출근 / 퇴근 표시 색상" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,0,0,10"/>

                        <!-- 근무중 색상 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="86"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="WorkingColorPreview" Width="12" Height="12" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="근무중 색상" Foreground="#CBD5E1" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#10B981" Tag="#10B981" Click="OnWorkingSwatchClick" ToolTip="에메랄드 그린 (#10B981)"/>
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#22C55E" Tag="#22C55E" Click="OnWorkingSwatchClick" ToolTip="네온 라임 (#22C55E)"/>
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#06B6D4" Tag="#06B6D4" Click="OnWorkingSwatchClick" ToolTip="시안 블루 (#06B6D4)"/>
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#3B82F6" Tag="#3B82F6" Click="OnWorkingSwatchClick" ToolTip="로얄 블루 (#3B82F6)"/>
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnWorkingSwatchClick" ToolTip="바이올렛 (#8B5CF6)"/>
                            </StackPanel>

                            <TextBox x:Name="WorkingHexBox" Grid.Column="2" Text="#10B981"
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569"
                                     Padding="6,3" FontSize="12" VerticalContentAlignment="Center"
                                     TextChanged="OnWorkingHexChanged"/>
                        </Grid>

                        <!-- 퇴근 색상 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="86"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="OffWorkColorPreview" Width="12" Height="12" Fill="#EF4444" Margin="0,0,6,0"/>
                                <TextBlock Text="퇴근 색상" Foreground="#CBD5E1" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#EF4444" Tag="#EF4444" Click="OnOffWorkSwatchClick" ToolTip="루비 레드 (#EF4444)"/>
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#F97316" Tag="#F97316" Click="OnOffWorkSwatchClick" ToolTip="코랄 오렌지 (#F97316)"/>
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#F59E0B" Tag="#F59E0B" Click="OnOffWorkSwatchClick" ToolTip="앰버 골드 (#F59E0B)"/>
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#EC4899" Tag="#EC4899" Click="OnOffWorkSwatchClick" ToolTip="로즈 핑크 (#EC4899)"/>
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#64748B" Tag="#64748B" Click="OnOffWorkSwatchClick" ToolTip="슬레이트 그레이 (#64748B)"/>
                            </StackPanel>

                            <TextBox x:Name="OffWorkHexBox" Grid.Column="2" Text="#EF4444"
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569"
                                     Padding="6,3" FontSize="12" VerticalContentAlignment="Center"
                                     TextChanged="OnOffWorkHexChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. 위젯 투명도 & 크기(사이즈) 조정 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <!-- 투명도 -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="💧 위젯 투명도 (불투명도)" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                            <TextBlock x:Name="OpacityValueText" Text="95%" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5"/>
                        </DockPanel>
                        <Slider x:Name="OpacitySlider" Minimum="0.25" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                Value="0.95" ValueChanged="OnOpacitySliderChanged" Margin="0,0,0,14"/>

                        <!-- 위젯 크기 -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="📐 위젯 크기 (배율)" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <TextBlock x:Name="ScaleValueText" Text="100%" Foreground="#38BDF8" FontWeight="Bold"
                                           FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource QuickScaleButtonStyle}" Content="80%" Tag="0.8" Click="OnQuickScaleClick"/>
                                <Button Style="{StaticResource QuickScaleButtonStyle}" Content="100%" Tag="1.0" Click="OnQuickScaleClick"/>
                                <Button Style="{StaticResource QuickScaleButtonStyle}" Content="120%" Tag="1.2" Click="OnQuickScaleClick"/>
                                <Button Style="{StaticResource QuickScaleButtonStyle}" Content="140%" Tag="1.4" Click="OnQuickScaleClick"/>
                            </StackPanel>
                        </DockPanel>
                        <Slider x:Name="ScaleSlider" Minimum="0.70" Maximum="1.60" SmallChange="0.05" LargeChange="0.1"
                                Value="1.0" ValueChanged="OnScaleSliderChanged"/>
                    </StackPanel>
                </Border>

                <!-- 4. 윈도우 동작 옵션 (항상 위 & 시작 시 자동 실행) -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="⚙️ 시스템 및 창 옵션" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,0,0,10"/>

                        <CheckBox x:Name="AlwaysOnTopCheck"
                                  Content="위젯을 항상 다른 창 위에 표시 (Always on Top)"
                                  Foreground="#E2E8F0" FontSize="12.5" Margin="0,0,0,8"
                                  Checked="OnBehaviorCheckChanged" Unchecked="OnBehaviorCheckChanged"/>

                        <CheckBox x:Name="RunAtStartupCheck"
                                  Content="Windows 시작 시 WorkDot 자동 실행"
                                  Foreground="#E2E8F0" FontSize="12.5"
                                  Checked="OnBehaviorCheckChanged" Unchecked="OnBehaviorCheckChanged"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 하단 버튼 바 & 버전 정보 -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="기본값으로 초기화" Click="OnResetDefaultsClick"
                    Background="#334155" Foreground="#E2E8F0" BorderThickness="0"
                    Padding="12,7" Cursor="Hand" DockPanel.Dock="Left"/>

            <TextBlock x:Name="FooterVersionText"
                       Text="WorkDot v1.1.0 · AlineStudio"
                       Foreground="#64748B" FontSize="11.5"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Button Content="완료" Click="OnCloseClick"
                    Background="#10B981" Foreground="#042F2E" FontWeight="Bold" BorderThickness="0"
                    Padding="20,7" Cursor="Hand" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
