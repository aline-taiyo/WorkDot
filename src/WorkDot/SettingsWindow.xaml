<Window x:Class="WorkDot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="환경설정"
        Icon="pack://application:,,,/WorkDot;component/Assets/Icons/workdot.ico"
        Width="440" Height="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ShadcnCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#121215"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ScalePillBtnStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShadcnComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0,0 L 4,4 L 8,0"
                          Stroke="#A1A1AA"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3F3F46"/>
                    <Setter TargetName="Border" Property="Background" Value="#1E1E22"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#52525B"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ShadcnComboBoxStyle" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ShadcnComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,28,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="220"
                                      Margin="0,4,0,8">
                                    <Border Background="#121215"
                                            BorderBrush="#27272A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShadcnTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CaretBrush" Value="#FAFAFA"/>
            <Setter Property="SelectionBrush" Value="#3F3F46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E22"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryPillCheckStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot"
                                         Width="6" Height="6"
                                         Fill="#52525B"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A10B981"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4D10B981"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#10B981"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- shadcn/ui Dialog Container (rounded-xl = 12px) -->
    <Border Margin="14"
            Background="#09090B"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <Border Grid.Row="0"
                    Padding="18,16,14,12"
                    Background="Transparent"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="환경설정"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FAFAFA"
                                       VerticalAlignment="Center"/>
                            <Border Background="#18181B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadgeText"
                                           Text="v1.5.0"
                                           FontFamily="{StaticResource SansFont}"
                                           Foreground="#A1A1AA"
                                           FontSize="11"
                                           FontWeight="Medium"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="위젯의 테마, 투명도·크기 및 업데이트 옵션을 설정합니다."
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="12"
                                   Foreground="#71717A"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WindowCloseBtnStyle}"
                            Click="OnCloseClick"
                            VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Dialog Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,2,18,6">
                <StackPanel>

                    <!-- 1. Theme Segmented Control (<Tabs>) -->
                    <Border Style="{StaticResource ShadcnCardStyle}">
                        <StackPanel>
                            <TextBlock Text="테마 모드"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FAFAFA"
                                       Margin="0,0,0,8"/>

                            <Border Background="#09090B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="3">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="ThemeSystemRadio"
                                                 Style="{StaticResource SegmentedRadioStyle}"
                                                 Content="시스템 설정"
                                                 Checked="OnThemeRadioChanged"/>
                                    <RadioButton x:Name="ThemeDarkRadio"
                                                 Style="{StaticResource SegmentedRadioStyle}"
                                                 Content="다크 모드"
                                                 Checked="OnThemeRadioChanged"/>
                                    <RadioButton x:Name="ThemeLightRadio"
                                                 Style="{StaticResource SegmentedRadioStyle}"
                                                 Content="라이트 모드"
                                                 Checked="OnThemeRadioChanged"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. Opacity & Scale -->
                    <Border Style="{StaticResource ShadcnCardStyle}">
                        <StackPanel>
                            <!-- Opacity -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="위젯 투명도"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FAFAFA"/>
                                <TextBlock x:Name="OpacityValueText"
                                           Text="100%"
                                           FontFamily="{StaticResource SansFont}"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           Foreground="#A1A1AA"
                                           FontWeight="Medium"
                                           FontSize="12"/>
                            </DockPanel>
                            <Slider x:Name="OpacitySlider"
                                    Style="{StaticResource ModernFlatSliderStyle}"
                                    Minimum="0.25" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                    Value="1.0"
                                    ValueChanged="OnOpacitySliderChanged"
                                    Margin="0,0,0,12"/>

                            <!-- Scale -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="위젯 크기"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FAFAFA"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ScaleValueText"
                                               Text="200%"
                                               FontFamily="{StaticResource SansFont}"
                                               Foreground="#A1A1AA"
                                               FontWeight="Medium"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource ScalePillBtnStyle}" Content="100%" Tag="1.0" Click="OnQuickScaleClick"/>
                                    <Button Style="{StaticResource ScalePillBtnStyle}" Content="150%" Tag="1.5" Click="OnQuickScaleClick"/>
                                    <Button Style="{StaticResource ScalePillBtnStyle}" Content="200%" Tag="2.0" Click="OnQuickScaleClick"/>
                                    <Button Style="{StaticResource ScalePillBtnStyle}" Content="300%" Tag="3.0" Click="OnQuickScaleClick"/>
                                </StackPanel>
                            </DockPanel>
                            <Slider x:Name="ScaleSlider"
                                    Style="{StaticResource ModernFlatSliderStyle}"
                                    Minimum="0.70" Maximum="3.00" SmallChange="0.05" LargeChange="0.1"
                                    Value="2.0"
                                    ValueChanged="OnScaleSliderChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Time Font Family -->
                    <Border Style="{StaticResource ShadcnCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="시간 표시 폰트"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FAFAFA"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="미리보기: "
                                               FontFamily="{StaticResource SansFont}"
                                               FontSize="11.5"
                                               Foreground="#71717A"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FontPreviewText"
                                               Text="08:15"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#10B981"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <ComboBox x:Name="TimeFontComboBox"
                                      Style="{StaticResource ShadcnComboBoxStyle}"
                                      SelectionChanged="OnTimeFontComboBoxSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{Binding}"
                                                   FontSize="12.5"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 4. Portal HotKey Card -->
                    <Border Style="{StaticResource ShadcnCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="근태홈 열기 단축키"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FAFAFA"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="HotKeyStatusText"
                                           Text="전역 단축키 활성화됨"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11.5"
                                           Foreground="#10B981"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="HotKeyInputBox"
                                         Style="{StaticResource ShadcnTextBoxStyle}"
                                         Text="Ctrl+Shift+F5"
                                         IsReadOnly="True"
                                         Cursor="Hand"
                                         ToolTip="클릭 후 원하는 단축키를 키보드로 누르세요. (Backspace/Delete로 해제)"
                                         PreviewKeyDown="OnHotKeyInputBoxPreviewKeyDown"/>

                                <Button Grid.Column="1"
                                        Style="{StaticResource ScalePillBtnStyle}"
                                        Content="지우기"
                                        Margin="6,0,0,0"
                                        Padding="10,6"
                                        VerticalAlignment="Stretch"
                                        ToolTip="단축키 사용 안 함"
                                        Click="OnClearHotKeyClick"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="추천: "
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11"
                                           Foreground="#71717A"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <Button Style="{StaticResource ScalePillBtnStyle}" Content="Ctrl+Shift+F5" Tag="Ctrl+Shift+F5" Click="OnPresetHotKeyClick"/>
                                <Button Style="{StaticResource ScalePillBtnStyle}" Content="Ctrl+Shift+W" Tag="Ctrl+Shift+W" Click="OnPresetHotKeyClick"/>
                                <Button Style="{StaticResource ScalePillBtnStyle}" Content="Alt+F12" Tag="Alt+F12" Click="OnPresetHotKeyClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4. Behavior & Auto-Update Switches -->
                    <Border Style="{StaticResource ShadcnCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="ExpandedModeCheck"
                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                      Margin="0,0,0,10"
                                      Checked="OnBehaviorCheckChanged"
                                      Unchecked="OnBehaviorCheckChanged">
                                <StackPanel>
                                    <TextBlock Text="위젯 확장 모드" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                    <TextBlock Text="출근·근무·휴게·퇴근 카테고리별 시간을 위젯에 표시합니다." FontSize="11.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <!-- 확장 모드 세부 설정 (표시 항목 & 글자 크기) -->
                            <Border x:Name="ExpandedModeOptionsPanel"
                                    Background="#09090B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="12,10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="표시 항목 선택"
                                               FontFamily="{StaticResource SansFont}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#D4D4D8"
                                               Margin="0,0,0,6"/>

                                    <UniformGrid Columns="4" Margin="-2,0,-2,12">
                                        <CheckBox x:Name="ShowClockInCheck"
                                                  Style="{StaticResource CategoryPillCheckStyle}"
                                                  Content="출근"
                                                  Checked="OnBehaviorCheckChanged"
                                                  Unchecked="OnBehaviorCheckChanged"/>
                                        <CheckBox x:Name="ShowWorkCheck"
                                                  Style="{StaticResource CategoryPillCheckStyle}"
                                                  Content="근무"
                                                  Checked="OnBehaviorCheckChanged"
                                                  Unchecked="OnBehaviorCheckChanged"/>
                                        <CheckBox x:Name="ShowBreakCheck"
                                                  Style="{StaticResource CategoryPillCheckStyle}"
                                                  Content="휴게"
                                                  Checked="OnBehaviorCheckChanged"
                                                  Unchecked="OnBehaviorCheckChanged"/>
                                        <CheckBox x:Name="ShowClockOutCheck"
                                                  Style="{StaticResource CategoryPillCheckStyle}"
                                                  Content="퇴근"
                                                  Checked="OnBehaviorCheckChanged"
                                                  Unchecked="OnBehaviorCheckChanged"/>
                                    </UniformGrid>

                                    <Border Height="1" Background="#1F1F23" Margin="0,0,0,10"/>

                                    <CheckBox x:Name="ShowCategoryLabelsCheck"
                                              Style="{StaticResource ModernToggleSwitchStyle}"
                                              Margin="0,0,0,10"
                                              Checked="OnBehaviorCheckChanged"
                                              Unchecked="OnBehaviorCheckChanged">
                                        <StackPanel>
                                            <TextBlock Text="출근/근무/휴게/퇴근 글자 표시" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                                            <TextBlock Text="라벨 글자를 표시합니다. 끄면 시간 숫자만 표시됩니다." FontSize="11" Foreground="#71717A" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <DockPanel x:Name="CategoryFontSizeHeaderPanel" Margin="0,0,0,5">
                                        <TextBlock Text="출근/근무/휴게/퇴근 글자 크기"
                                                   FontFamily="{StaticResource SansFont}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#D4D4D8"/>
                                        <TextBlock x:Name="CategoryFontSizeValueText"
                                                   Text="7.0pt"
                                                   FontFamily="{StaticResource SansFont}"
                                                   DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#A1A1AA"
                                                   FontWeight="Medium"
                                                   FontSize="11.5"/>
                                    </DockPanel>
                                    <Slider x:Name="CategoryFontSizeSlider"
                                            Style="{StaticResource ModernFlatSliderStyle}"
                                            Minimum="7.0" Maximum="18.0" SmallChange="0.5" LargeChange="1.0"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            Value="7.0"
                                            ValueChanged="OnCategoryFontSizeSliderChanged"
                                            Margin="0,0,0,10"/>

                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="시간 숫자 글자 크기"
                                                   FontFamily="{StaticResource SansFont}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#D4D4D8"/>
                                        <TextBlock x:Name="TimeFontSizeValueText"
                                                   Text="11.5pt"
                                                   FontFamily="{StaticResource SansFont}"
                                                   DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#A1A1AA"
                                                   FontWeight="Medium"
                                                   FontSize="11.5"/>
                                    </DockPanel>
                                    <Slider x:Name="TimeFontSizeSlider"
                                            Style="{StaticResource ModernFlatSliderStyle}"
                                            Minimum="8.0" Maximum="22.0" SmallChange="0.5" LargeChange="1.0"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            Value="11.5"
                                            ValueChanged="OnTimeFontSizeSliderChanged"/>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="#1F1F23" Margin="0,0,0,10"/>

                            <CheckBox x:Name="AlwaysOnTopCheck"
                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                      Margin="0,0,0,10"
                                      Checked="OnBehaviorCheckChanged"
                                      Unchecked="OnBehaviorCheckChanged">
                                <StackPanel>
                                    <TextBlock Text="항상 위에 표시" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                    <TextBlock Text="다른 앱 창에 가려지지 않도록 최상단에 고정합니다." FontSize="11.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="#1F1F23" Margin="0,0,0,10"/>

                            <CheckBox x:Name="RunAtStartupCheck"
                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                      Margin="0,0,0,10"
                                      Checked="OnBehaviorCheckChanged"
                                      Unchecked="OnBehaviorCheckChanged">
                                <StackPanel>
                                    <TextBlock Text="Windows 시작 시 자동 실행" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                    <TextBlock Text="PC 시작 시 WorkDot을 자동으로 실행합니다." FontSize="11.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="#1F1F23" Margin="0,0,0,10"/>

                            <CheckBox x:Name="AutoUpdateCheck"
                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                      Checked="OnBehaviorCheckChanged"
                                      Unchecked="OnBehaviorCheckChanged">
                                <StackPanel>
                                    <TextBlock Text="최신 릴리즈 자동 업데이트" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                    <TextBlock Text="새 버전 배포 시 백그라운드에서 자동으로 업데이트합니다." FontSize="11.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- 5. Manual Update Check & Open Repository Buttons Only -->
                    <UniformGrid Columns="2" Margin="0">
                        <Button x:Name="CheckUpdateButton"
                                Style="{StaticResource ModernActionBtnStyle}"
                                Content="업데이트 확인"
                                Background="#121215"
                                BorderBrush="#27272A"
                                Foreground="#E4E4E7"
                                Padding="10,8"
                                Margin="0,0,5,0"
                                Click="OnCheckUpdateClick"/>

                        <Button Style="{StaticResource ModernActionBtnStyle}"
                                Content="저장소 열기"
                                Background="#121215"
                                BorderBrush="#27272A"
                                Foreground="#FAFAFA"
                                Padding="10,8"
                                Margin="5,0,0,0"
                                ToolTip="https://github.com/aline-taiyo/WorkDot"
                                Click="OnOpenGitHubRepoClick"/>
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>

            <!-- Dialog Footer -->
            <Border Grid.Row="2"
                    BorderBrush="#1F1F23"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <DockPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernActionBtnStyle}"
                            Content="기본값 복원"
                            Background="#18181B"
                            BorderBrush="#27272A"
                            Foreground="#E4E4E7"
                            Padding="12,6"
                            Click="OnResetDefaultsClick"
                            DockPanel.Dock="Left"/>

                    <Button Style="{StaticResource ModernActionBtnStyle}"
                            Content="확인"
                            Background="#FAFAFA"
                            BorderBrush="#FAFAFA"
                            Foreground="#09090B"
                            Padding="20,6"
                            Click="OnCloseClick"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
