<Window x:Class="WorkDot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="환경설정"
        Width="440" Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ShadcnCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#121215"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ColorChipBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBd" Property="BorderBrush" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScalePillBtnStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- shadcn/ui Dialog Container (rounded-xl = 12px) -->
    <Border Margin="14"
            Background="#09090B"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <Border Grid.Row="0"
                    Padding="18,16,14,12"
                    Background="Transparent"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="환경설정"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FAFAFA"
                                       VerticalAlignment="Center"/>
                            <Border Background="#18181B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadgeText"
                                           Text="v1.5.0"
                                           FontFamily="{StaticResource SansFont}"
                                           Foreground="#A1A1AA"
                                           FontSize="11"
                                           FontWeight="Medium"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="위젯의 테마, 상태 색상 및 업데이트 옵션을 설정합니다."
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="12"
                                   Foreground="#71717A"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WindowCloseBtnStyle}"
                            Click="OnCloseClick"
                            VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Dialog Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,2,18,6">
                <StackPanel>

                    <!-- 1. Theme Segmented Control (<Tabs>) -->
                    <Border Style="{StaticResource ShadcnCardStyle}">
                        <StackPanel>
                            <TextBlock Text="테마 모드"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FAFAFA"
                                       Margin="0,0,0,8"/>

                            <Border Background="#09090B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="3">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="ThemeSystemRadio"
                                                 Style="{StaticResource SegmentedRadioStyle}"
                                                 Content="시스템 설정"
                                                 Checked="OnThemeRadioChanged"/>
                                    <RadioButton x:Name="ThemeDarkRadio"
                                                 Style="{StaticResource SegmentedRadioStyle}"
                                                 Content="다크 모드"
                                                 Checked="OnThemeRadioChanged"/>
                                    <RadioButton x:Name="ThemeLightRadio"
                                                 Style="{StaticResource SegmentedRadioStyle}"
                                                 Content="라이트 모드"
                                                 Checked="OnThemeRadioChanged"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. Status Colors -->
                    <Border Style="{StaticResource ShadcnCardStyle}">
                        <StackPanel>
                            <TextBlock Text="상태 인디케이터 색상"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FAFAFA"
                                       Margin="0,0,0,10"/>

                            <!-- Working Color -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="WorkingColorPreview" Width="9" Height="9" Fill="#10B981" Margin="0,0,7,0"/>
                                    <TextBlock Text="근무중" FontFamily="{StaticResource SansFont}" Foreground="#E4E4E7" FontSize="12.5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ColorChipBtnStyle}" Background="#10B981" Tag="#10B981" Click="OnWorkingSwatchClick"/>
                                    <Button Style="{StaticResource ColorChipBtnStyle}" Background="#22C55E" Tag="#22C55E" Click="OnWorkingSwatchClick"/>
                                    <Button Style="{StaticResource ColorChipBtnStyle}" Background="#06B6D4" Tag="#06B6D4" Click="OnWorkingSwatchClick"/>
                                    <Button Style="{StaticResource ColorChipBtnStyle}" Background="#3B82F6" Tag="#3B82F6" Click="OnWorkingSwatchClick"/>
                                    <Button Style="{StaticResource ColorChipBtnStyle}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnWorkingSwatchClick"/>
                                </StackPanel>

                                <TextBox x:Name="WorkingHexBox"
                                         Grid.Column="2"
                                         Style="{StaticResource ModernHexTextBoxStyle}"
                                         Text="#10B981"
                                         TextChanged="OnWorkingHexChanged"/>
                            </Grid>

                            <!-- Off-Work Color -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="OffWorkColorPreview" Width="9" Height="9" Fill="#EF4444" Margin="0,0,7,0"/>
                                    <TextBlock Text="퇴근" FontFamily="{StaticResource SansFont}" Foreground="#E4E4E7" FontSize="12.5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ColorChipBtnStyle}" Background="#EF4444" Tag="#EF4444" Click="OnOffWorkSwatchClick"/>
                                    <Button Style="{StaticResource ColorChipBtnStyle}" Background="#F97316" Tag="#F97316" Click="OnOffWorkSwatchClick"/>
                                    <Button Style="{StaticResource ColorChipBtnStyle}" Background="#F59E0B" Tag="#F59E0B" Click="OnOffWorkSwatchClick"/>
                                    <Button Style="{StaticResource ColorChipBtnStyle}" Background="#EC4899" Tag="#EC4899" Click="OnOffWorkSwatchClick"/>
                                    <Button Style="{StaticResource ColorChipBtnStyle}" Background="#71717A" Tag="#71717A" Click="OnOffWorkSwatchClick"/>
                                </StackPanel>

                                <TextBox x:Name="OffWorkHexBox"
                                         Grid.Column="2"
                                         Style="{StaticResource ModernHexTextBoxStyle}"
                                         Text="#EF4444"
                                         TextChanged="OnOffWorkHexChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. Opacity & Scale -->
                    <Border Style="{StaticResource ShadcnCardStyle}">
                        <StackPanel>
                            <!-- Opacity -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="위젯 투명도"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FAFAFA"/>
                                <TextBlock x:Name="OpacityValueText"
                                           Text="95%"
                                           FontFamily="{StaticResource SansFont}"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           Foreground="#A1A1AA"
                                           FontWeight="Medium"
                                           FontSize="12"/>
                            </DockPanel>
                            <Slider x:Name="OpacitySlider"
                                    Style="{StaticResource ModernFlatSliderStyle}"
                                    Minimum="0.25" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                    Value="0.95"
                                    ValueChanged="OnOpacitySliderChanged"
                                    Margin="0,0,0,12"/>

                            <!-- Scale -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="위젯 크기"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FAFAFA"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ScaleValueText"
                                               Text="100%"
                                               FontFamily="{StaticResource SansFont}"
                                               Foreground="#A1A1AA"
                                               FontWeight="Medium"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource ScalePillBtnStyle}" Content="80%" Tag="0.8" Click="OnQuickScaleClick"/>
                                    <Button Style="{StaticResource ScalePillBtnStyle}" Content="100%" Tag="1.0" Click="OnQuickScaleClick"/>
                                    <Button Style="{StaticResource ScalePillBtnStyle}" Content="120%" Tag="1.2" Click="OnQuickScaleClick"/>
                                    <Button Style="{StaticResource ScalePillBtnStyle}" Content="140%" Tag="1.4" Click="OnQuickScaleClick"/>
                                </StackPanel>
                            </DockPanel>
                            <Slider x:Name="ScaleSlider"
                                    Style="{StaticResource ModernFlatSliderStyle}"
                                    Minimum="0.70" Maximum="1.60" SmallChange="0.05" LargeChange="0.1"
                                    Value="1.0"
                                    ValueChanged="OnScaleSliderChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Behavior & Auto-Update Switches -->
                    <Border Style="{StaticResource ShadcnCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="AlwaysOnTopCheck"
                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                      Margin="0,0,0,10"
                                      Checked="OnBehaviorCheckChanged"
                                      Unchecked="OnBehaviorCheckChanged">
                                <StackPanel>
                                    <TextBlock Text="항상 위에 표시" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                    <TextBlock Text="다른 앱 창에 가려지지 않도록 최상단에 고정합니다." FontSize="11.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="#1F1F23" Margin="0,0,0,10"/>

                            <CheckBox x:Name="RunAtStartupCheck"
                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                      Margin="0,0,0,10"
                                      Checked="OnBehaviorCheckChanged"
                                      Unchecked="OnBehaviorCheckChanged">
                                <StackPanel>
                                    <TextBlock Text="Windows 시작 시 자동 실행" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                    <TextBlock Text="PC 시작 시 WorkDot을 자동으로 실행합니다." FontSize="11.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="#1F1F23" Margin="0,0,0,10"/>

                            <CheckBox x:Name="AutoUpdateCheck"
                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                      Checked="OnBehaviorCheckChanged"
                                      Unchecked="OnBehaviorCheckChanged">
                                <StackPanel>
                                    <TextBlock Text="GitHub 릴리스 자동 업데이트" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                    <TextBlock Text="새 버전 배포 시 백그라운드에서 자동으로 업데이트합니다." FontSize="11.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- 5. GitHub Repository & Manual Update Check -->
                    <Border Style="{StaticResource ShadcnCardStyle}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="GitHub 저장소 및 업데이트"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FAFAFA"/>
                                <TextBlock x:Name="UpdateStatusText"
                                           Text="github.com/xl-taiyo/WorkDot"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11.5"
                                           Foreground="#71717A"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CheckUpdateButton"
                                        Style="{StaticResource ModernActionBtnStyle}"
                                        Content="업데이트 확인"
                                        Background="#18181B"
                                        BorderBrush="#27272A"
                                        Foreground="#E4E4E7"
                                        Padding="10,5"
                                        Margin="0,0,6,0"
                                        Click="OnCheckUpdateClick"/>

                                <Button Style="{StaticResource ModernActionBtnStyle}"
                                        Content="GitHub 열기"
                                        Background="#18181B"
                                        BorderBrush="#27272A"
                                        Foreground="#FAFAFA"
                                        Padding="10,5"
                                        ToolTip="https://github.com/xl-taiyo/WorkDot 브라우저로 열기"
                                        Click="OnOpenGitHubRepoClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Dialog Footer -->
            <Border Grid.Row="2"
                    BorderBrush="#1F1F23"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <DockPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernActionBtnStyle}"
                            Content="기본값 복원"
                            Background="#18181B"
                            BorderBrush="#27272A"
                            Foreground="#E4E4E7"
                            Padding="12,6"
                            Click="OnResetDefaultsClick"
                            DockPanel.Dock="Left"/>

                    <Button Style="{StaticResource ModernActionBtnStyle}"
                            Content="확인"
                            Background="#FAFAFA"
                            BorderBrush="#FAFAFA"
                            Foreground="#09090B"
                            Padding="20,6"
                            Click="OnCloseClick"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"/>

                    <TextBlock x:Name="FooterVersionText"
                               Text="WorkDot v1.5.0"
                               FontFamily="{StaticResource SansFont}"
                               Foreground="#52525B"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
