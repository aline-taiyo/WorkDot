<Window x:Class="WorkDot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkDot Configuration"
        Width="440" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="TechSectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#101014"/>
            <Setter Property="BorderBrush" Value="#24242C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Sharp Square Color Swatch -->
        <Style x:Key="SquareSwatchBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#34343E"
                                BorderThickness="1"
                                CornerRadius="0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBd" Property="BorderBrush" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sharp Scale Preset Button -->
        <Style x:Key="ScalePresetBtnStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Background" Value="#0A0A0C"/>
            <Setter Property="Foreground" Value="#8E8E98"/>
            <Setter Property="BorderBrush" Value="#24242C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E26"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#52525E"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Shadow Margin -->
    <Border Margin="10"
            Background="#0A0A0C"
            BorderBrush="#2E2E38"
            BorderThickness="1"
            CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Signal Line -->
                <RowDefinition Height="2"/>
                <!-- Custom Frameless Title Bar -->
                <RowDefinition Height="42"/>
                <!-- Body -->
                <RowDefinition Height="*"/>
                <!-- Footer -->
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- Top 2px Accent Line -->
            <Rectangle Grid.Row="0" Fill="#10B981"/>

            <!-- Custom Draggable Header -->
            <Border Grid.Row="1"
                    Background="#0E0E12"
                    BorderBrush="#22222A"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,8,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Rectangle Width="6" Height="6" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="WORKDOT // CONFIG"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#FAFAFA"
                                   VerticalAlignment="Center"/>
                        <Border Background="#18181F"
                                BorderBrush="#2A2A34"
                                BorderThickness="1"
                                Padding="6,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadgeText"
                                       Text="v1.3.0"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="#71717A"
                                       FontSize="10"/>
                        </Border>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource WindowCloseBtnStyle}"
                            Click="OnCloseClick"
                            VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,12,14,4">
                <StackPanel>

                    <!-- 01 // THEME -->
                    <Border Style="{StaticResource TechSectionBorderStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="01 // THEME MODE"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="#71717A"/>
                                <TextBlock Text="위젯 표면 테마"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           Foreground="#52525E"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>

                            <UniformGrid Columns="3">
                                <RadioButton x:Name="ThemeSystemRadio"
                                             Style="{StaticResource SegmentedRadioStyle}"
                                             Content="SYSTEM (자동)"
                                             Checked="OnThemeRadioChanged"/>
                                <RadioButton x:Name="ThemeDarkRadio"
                                             Style="{StaticResource SegmentedRadioStyle}"
                                             Content="DARK (다크)"
                                             Checked="OnThemeRadioChanged"/>
                                <RadioButton x:Name="ThemeLightRadio"
                                             Style="{StaticResource SegmentedRadioStyle}"
                                             Content="LIGHT (라이트)"
                                             Checked="OnThemeRadioChanged"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 02 // SIGNAL COLORS -->
                    <Border Style="{StaticResource TechSectionBorderStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="02 // SIGNAL COLORS"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="#71717A"/>
                                <TextBlock Text="상태 인디케이터 색상"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           Foreground="#52525E"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Working Color -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle x:Name="WorkingColorPreview" Width="8" Height="8" Fill="#10B981" Margin="0,0,7,0"/>
                                    <TextBlock Text="근무중 (ON)" FontFamily="{StaticResource MonoFont}" Foreground="#D4D4D8" FontSize="11.5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SquareSwatchBtnStyle}" Background="#10B981" Tag="#10B981" Click="OnWorkingSwatchClick"/>
                                    <Button Style="{StaticResource SquareSwatchBtnStyle}" Background="#00E676" Tag="#00E676" Click="OnWorkingSwatchClick"/>
                                    <Button Style="{StaticResource SquareSwatchBtnStyle}" Background="#06B6D4" Tag="#06B6D4" Click="OnWorkingSwatchClick"/>
                                    <Button Style="{StaticResource SquareSwatchBtnStyle}" Background="#3B82F6" Tag="#3B82F6" Click="OnWorkingSwatchClick"/>
                                    <Button Style="{StaticResource SquareSwatchBtnStyle}" Background="#A855F7" Tag="#A855F7" Click="OnWorkingSwatchClick"/>
                                </StackPanel>

                                <TextBox x:Name="WorkingHexBox"
                                         Grid.Column="2"
                                         Style="{StaticResource ModernHexTextBoxStyle}"
                                         Text="#10B981"
                                         TextChanged="OnWorkingHexChanged"/>
                            </Grid>

                            <!-- Off-Work Color -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle x:Name="OffWorkColorPreview" Width="8" Height="8" Fill="#EF4444" Margin="0,0,7,0"/>
                                    <TextBlock Text="퇴근 (OFF)" FontFamily="{StaticResource MonoFont}" Foreground="#D4D4D8" FontSize="11.5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SquareSwatchBtnStyle}" Background="#EF4444" Tag="#EF4444" Click="OnOffWorkSwatchClick"/>
                                    <Button Style="{StaticResource SquareSwatchBtnStyle}" Background="#FF2A54" Tag="#FF2A54" Click="OnOffWorkSwatchClick"/>
                                    <Button Style="{StaticResource SquareSwatchBtnStyle}" Background="#F97316" Tag="#F97316" Click="OnOffWorkSwatchClick"/>
                                    <Button Style="{StaticResource SquareSwatchBtnStyle}" Background="#EAB308" Tag="#EAB308" Click="OnOffWorkSwatchClick"/>
                                    <Button Style="{StaticResource SquareSwatchBtnStyle}" Background="#71717A" Tag="#71717A" Click="OnOffWorkSwatchClick"/>
                                </StackPanel>

                                <TextBox x:Name="OffWorkHexBox"
                                         Grid.Column="2"
                                         Style="{StaticResource ModernHexTextBoxStyle}"
                                         Text="#EF4444"
                                         TextChanged="OnOffWorkHexChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 03 // OPTICS & SCALE -->
                    <Border Style="{StaticResource TechSectionBorderStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="03 // OPTICS &amp; SCALE"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="#71717A"/>
                                <TextBlock Text="투명도 및 크기"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           Foreground="#52525E"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Opacity -->
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="OPACITY (불투명도)"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11.5"
                                           Foreground="#D4D4D8"/>
                                <TextBlock x:Name="OpacityValueText"
                                           Text="95%"
                                           FontFamily="{StaticResource MonoFont}"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           Foreground="#10B981"
                                           FontWeight="Bold"
                                           FontSize="11.5"/>
                            </DockPanel>
                            <Slider x:Name="OpacitySlider"
                                    Style="{StaticResource ModernFlatSliderStyle}"
                                    Minimum="0.25" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                    Value="0.95"
                                    ValueChanged="OnOpacitySliderChanged"
                                    Margin="0,0,0,12"/>

                            <!-- Scale -->
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="SCALE (배율)"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11.5"
                                           Foreground="#D4D4D8"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ScaleValueText"
                                               Text="100%"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="#10B981"
                                               FontWeight="Bold"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource ScalePresetBtnStyle}" Content="80%" Tag="0.8" Click="OnQuickScaleClick"/>
                                    <Button Style="{StaticResource ScalePresetBtnStyle}" Content="100%" Tag="1.0" Click="OnQuickScaleClick"/>
                                    <Button Style="{StaticResource ScalePresetBtnStyle}" Content="120%" Tag="1.2" Click="OnQuickScaleClick"/>
                                    <Button Style="{StaticResource ScalePresetBtnStyle}" Content="140%" Tag="1.4" Click="OnQuickScaleClick"/>
                                </StackPanel>
                            </DockPanel>
                            <Slider x:Name="ScaleSlider"
                                    Style="{StaticResource ModernFlatSliderStyle}"
                                    Minimum="0.70" Maximum="1.60" SmallChange="0.05" LargeChange="0.1"
                                    Value="1.0"
                                    ValueChanged="OnScaleSliderChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 04 // SYSTEM -->
                    <Border Style="{StaticResource TechSectionBorderStyle}" Margin="0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="04 // SYSTEM BEHAVIOR"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="#71717A"/>
                                <TextBlock Text="윈도우 동작"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           Foreground="#52525E"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>

                            <CheckBox x:Name="AlwaysOnTopCheck"
                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                      Content="항상 다른 창 위에 고정 (ALWAYS ON TOP)"
                                      Margin="0,0,0,10"
                                      Checked="OnBehaviorCheckChanged"
                                      Unchecked="OnBehaviorCheckChanged"/>

                            <CheckBox x:Name="RunAtStartupCheck"
                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                      Content="Windows 시작 시 자동 실행 (AUTO-START)"
                                      Checked="OnBehaviorCheckChanged"
                                      Unchecked="OnBehaviorCheckChanged"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Bar -->
            <Border Grid.Row="3"
                    Background="#0E0E12"
                    BorderBrush="#22222A"
                    BorderThickness="0,1,0,0"
                    Padding="14,0">
                <DockPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource ScalePresetBtnStyle}"
                            Content="RESET DEFAULT"
                            Padding="10,5"
                            Margin="0"
                            Click="OnResetDefaultsClick"
                            DockPanel.Dock="Left"/>

                    <Button Style="{StaticResource ModernActionBtnStyle}"
                            Content="CLOSE"
                            Background="#1410B981"
                            BorderBrush="#10B981"
                            Foreground="#10B981"
                            Padding="18,5"
                            Click="OnCloseClick"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"/>

                    <TextBlock x:Name="FooterVersionText"
                               Text="ALINESTUDIO // v1.3.0"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="#52525E"
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
