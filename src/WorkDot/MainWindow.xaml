<Window x:Class="WorkDot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkDot"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseRingScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="2.2" Duration="0:0:2.0">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRingScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="2.2" Duration="0:0:2.0">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.65" To="0.0" Duration="0:0:2.0"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootContainer"
          Margin="14"
          MouseLeftButtonDown="OnOverlayMouseLeftButtonDown"
          MouseMove="OnOverlayMouseMove"
          MouseLeftButtonUp="OnOverlayMouseLeftButtonUp"
          MouseWheel="OnOverlayMouseWheel"
          MouseEnter="OnOverlayMouseEnter"
          MouseLeave="OnOverlayMouseLeave">

        <Grid.ContextMenu>
            <ContextMenu x:Name="OverlayContextMenu" Opened="OnContextMenuOpened">
                <MenuItem x:Name="MenuVersionHeader" Header="WorkDot v1.4.0" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="환경설정" Click="OnOpenSettingsClick"/>
                <MenuItem Header="다우오피스 근태 창 열기" Click="OnOpenPortalClick"/>
                <MenuItem Header="지금 상태 동기화" Click="OnRefreshClick"/>
                <Separator/>
                <MenuItem x:Name="MenuAlwaysOnTop" Header="항상 위에 표시" IsCheckable="True" Click="OnMenuAlwaysOnTopClick"/>
                <MenuItem x:Name="MenuRunAtStartup" Header="Windows 시작 시 자동 실행" IsCheckable="True" Click="OnMenuRunAtStartupClick"/>
                <MenuItem Header="위젯 크기">
                    <MenuItem Header="작게 (80%)" Tag="0.8" Click="OnMenuQuickScaleClick"/>
                    <MenuItem Header="보통 (100%)" Tag="1.0" Click="OnMenuQuickScaleClick"/>
                    <MenuItem Header="크게 (120%)" Tag="1.2" Click="OnMenuQuickScaleClick"/>
                    <MenuItem Header="아주 크게 (140%)" Tag="1.4" Click="OnMenuQuickScaleClick"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="수동 상태 전환">
                    <MenuItem Header="근무중으로 표시" Click="OnForceWorkingClick"/>
                    <MenuItem Header="퇴근으로 표시" Click="OnForceOffWorkClick"/>
                </MenuItem>
                <MenuItem Header="작업 표시줄 위로 정렬" Click="OnSnapToTaskbarClick"/>
                <MenuItem Header="미니 배지 모드 전환" Click="OnToggleMiniModeClick"/>
                <MenuItem Header="위젯 숨기기" Click="OnHideOverlayClick"/>
                <Separator/>
                <MenuItem Header="종료" Click="OnExitClick"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Modern React / Vercel / Linear Single-Line Floating Toolbar (rounded-xl = 10px) -->
        <Border x:Name="CapsuleBorder"
                CornerRadius="10"
                Background="#09090B"
                BorderBrush="#27272A"
                BorderThickness="1"
                Padding="6,5">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="CapsuleScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            </Border.LayoutTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="16"
                                  ShadowDepth="4"
                                  Opacity="0.45"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 1. shadcn/ui Status Badge Chip (rounded-md = 6px) -->
                <Border x:Name="StatusBadgeBorder"
                        CornerRadius="6"
                        Background="#1A10B981"
                        BorderBrush="#3310B981"
                        BorderThickness="1"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        ToolTip="더블클릭: 미니 배지 모드 전환 | Ctrl+휠: 크기 조절">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse x:Name="PulseRing"
                                     Width="7" Height="7"
                                     Fill="#10B981"
                                     Opacity="0.6"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseRingScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="StatusCoreDot"
                                     Width="7" Height="7"
                                     Fill="#10B981"/>
                        </Grid>

                        <TextBlock x:Name="StatusTitleText"
                                   Text="근무중"
                                   FontFamily="{StaticResource SansFont}"
                                   Foreground="#10B981"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 2. Single-Line Time & Dock Info -->
                <StackPanel x:Name="InfoPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="9,0,2,0">

                    <TextBlock x:Name="SubStatusText"
                               Text="동기화 중..."
                               FontFamily="{StaticResource SansFont}"
                               Foreground="#A1A1AA"
                               FontSize="12"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>

                    <!-- Docked Window Pill -->
                    <Border x:Name="SnapBadge"
                            Background="#18181B"
                            BorderBrush="#27272A"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,2"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeomSnap}"
                                  Stroke="#71717A"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="10" Height="10"
                                  Stretch="Uniform"
                                  Margin="0,0,4,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="SnapBadgeText"
                                       Text="작업 표시줄"
                                       FontFamily="{StaticResource SansFont}"
                                       Foreground="#71717A"
                                       FontSize="11"
                                       MaxWidth="95"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. Divider + Action Button & Lucide Icon Buttons -->
                <StackPanel x:Name="ActionPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- 1px Vertical Divider -->
                    <Border x:Name="ActionDivider"
                            Width="1" Height="16"
                            Background="#27272A"
                            Margin="9,0,8,0"
                            VerticalAlignment="Center"/>

                    <!-- Primary Action Button -->
                    <Button x:Name="PrimaryActionButton"
                            Style="{StaticResource ModernActionBtnStyle}"
                            Content="출근하기"
                            Background="#FAFAFA"
                            Foreground="#09090B"
                            Click="OnPrimaryActionClick"
                            Margin="0,0,4,0"/>

                    <!-- Portal Button -->
                    <Button x:Name="PortalIconButton"
                            Style="{StaticResource ModernIconBtnStyle}"
                            ToolTip="다우오피스 근태 창 열기"
                            Click="OnOpenPortalClick"
                            Margin="0,0,1,0">
                        <Path Data="{StaticResource GeomExternal}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="13" Height="13"
                              Stretch="Uniform"/>
                    </Button>

                    <!-- Refresh Button -->
                    <Button x:Name="RefreshIconButton"
                            Style="{StaticResource ModernIconBtnStyle}"
                            ToolTip="상태 새로고침"
                            Click="OnRefreshClick"
                            Margin="0,0,1,0">
                        <Path Data="{StaticResource GeomRefresh}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="13" Height="13"
                              Stretch="Uniform"/>
                    </Button>

                    <!-- Settings Button -->
                    <Button x:Name="SettingsIconButton"
                            Style="{StaticResource ModernIconBtnStyle}"
                            ToolTip="환경설정"
                            Click="OnOpenSettingsClick">
                        <Path Data="{StaticResource GeomSettings}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="13" Height="13"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
