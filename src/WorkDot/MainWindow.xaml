<Window x:Class="WorkDot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkDot"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <ImageBrush x:Key="BrushIconHome"
                    ImageSource="pack://application:,,,/Assets/Icons/icons8-home-96.png"
                    Stretch="Uniform"
                    RenderOptions.BitmapScalingMode="HighQuality"/>
        <ImageBrush x:Key="BrushIconReboot"
                    ImageSource="pack://application:,,,/Assets/Icons/icons8-reboot-96.png"
                    Stretch="Uniform"
                    RenderOptions.BitmapScalingMode="HighQuality"/>
        <ImageBrush x:Key="BrushIconSettings"
                    ImageSource="pack://application:,,,/Assets/Icons/icons8-settings-96.png"
                    Stretch="Uniform"
                    RenderOptions.BitmapScalingMode="HighQuality"/>
    </Window.Resources>

    <Grid x:Name="RootContainer"
          Margin="0"
          MouseLeftButtonDown="OnOverlayMouseLeftButtonDown"
          MouseMove="OnOverlayMouseMove"
          MouseLeftButtonUp="OnOverlayMouseLeftButtonUp"
          MouseWheel="OnOverlayMouseWheel"
          MouseEnter="OnOverlayMouseEnter"
          MouseLeave="OnOverlayMouseLeave">

        <Grid.ContextMenu>
            <ContextMenu x:Name="OverlayContextMenu" Opened="OnContextMenuOpened">
                <MenuItem x:Name="MenuVersionHeader" Header="WorkDot v1.5.0" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="MenuClockActionItem" Header="퇴근하기" FontWeight="SemiBold" Click="OnMenuClockActionClick"/>
                <Separator/>
                <MenuItem Header="환경설정" Click="OnOpenSettingsClick"/>
                <MenuItem Header="브라우저 열기" Click="OnOpenPortalClick"/>
                <MenuItem Header="새로고침" Click="OnRefreshClick"/>
                <Separator/>
                <MenuItem x:Name="MenuAlwaysOnTop" Header="항상 위에 표시" IsCheckable="True" Click="OnMenuAlwaysOnTopClick"/>
                <MenuItem x:Name="MenuRunAtStartup" Header="Windows 시작 시 자동 실행" IsCheckable="True" Click="OnMenuRunAtStartupClick"/>
                <MenuItem Header="위젯 크기">
                    <MenuItem Header="80%" Tag="0.8" Click="OnMenuQuickScaleClick"/>
                    <MenuItem Header="100%" Tag="1.0" Click="OnMenuQuickScaleClick"/>
                    <MenuItem Header="120%" Tag="1.2" Click="OnMenuQuickScaleClick"/>
                    <MenuItem Header="140%" Tag="1.4" Click="OnMenuQuickScaleClick"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="상태 전환">
                    <MenuItem Header="근무중" Click="OnForceWorkingClick"/>
                    <MenuItem Header="퇴근" Click="OnForceOffWorkClick"/>
                </MenuItem>
                <MenuItem Header="윈도우 경계 정렬" Click="OnSnapToTaskbarClick"/>
                <MenuItem Header="숨기기" Click="OnHideOverlayClick"/>
                <Separator/>
                <MenuItem Header="종료" Click="OnExitClick"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Minimal Icon-First Floating Toolbar (Always Mini by default, Expands on Hover) -->
        <Border x:Name="CapsuleBorder"
                CornerRadius="10"
                Background="#09090B"
                BorderBrush="#27272A"
                BorderThickness="1"
                Padding="5,4">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="CapsuleScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            </Border.LayoutTransform>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 1. Status Chip: App-Icon Clock Gauge (8시간 기준 초록 게이지 / 8시간 달성 시 빨간 게이지) + 10s Idle Working Elapsed Time -->
                <Border x:Name="StatusBadgeBorder"
                        CornerRadius="6"
                        Background="#1A10B981"
                        BorderBrush="#3310B981"
                        BorderThickness="1"
                        Padding="6,4"
                        VerticalAlignment="Center"
                        ToolTip="근무중">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Canvas x:Name="ClockGaugeCanvas"
                                Width="18" Height="18"
                                VerticalAlignment="Center">
                            <!-- Background Track Ring -->
                            <Ellipse x:Name="ClockTrackRing"
                                     Width="14.4" Height="14.4"
                                     Canvas.Left="1.8" Canvas.Top="1.8"
                                     Stroke="#27272A"
                                     StrokeThickness="2.2"/>

                            <!-- Full 360-degree Ring (8시간 달성 시 빨간 게이지) -->
                            <Ellipse x:Name="ClockFullRing"
                                     Width="14.4" Height="14.4"
                                     Canvas.Left="1.8" Canvas.Top="1.8"
                                     Stroke="#EF4444"
                                     StrokeThickness="2.2"
                                     Visibility="Collapsed"/>

                            <!-- Partial Progress Arc (0 ~ 8시간 진행 중 초록 게이지) -->
                            <Path x:Name="ClockGaugeArcPath"
                                  Stroke="#10B981"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>

                            <!-- App-Icon Geometric Clock Hands -->
                            <Path x:Name="ClockHandsPath"
                                  Data="M 9,9 L 9,5.3 M 9,9 L 6.3,9"
                                  Stroke="#FAFAFA"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                            <Ellipse x:Name="ClockCenterPivot"
                                     Width="2.4" Height="2.4"
                                     Canvas.Left="7.8" Canvas.Top="7.8"
                                     Fill="#FAFAFA"/>

                            <!-- Signature WorkDot Status Orb on Ring -->
                            <Ellipse x:Name="ClockTipCutout"
                                     Width="5.2" Height="5.2"
                                     Canvas.Left="11.2" Canvas.Top="1.8"
                                     Fill="#09090B"/>
                            <Ellipse x:Name="ClockTipDot"
                                     Width="3.6" Height="3.6"
                                     Canvas.Left="12.0" Canvas.Top="2.6"
                                     Fill="#34D399"/>
                        </Canvas>

                        <TextBlock x:Name="SubStatusText"
                                   Text=""
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="#10B981"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Margin="6,0,1,0"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 2. Divider + Icon Action Bar (Hidden in Mini Mode, Shown on Hover) -->
                <StackPanel x:Name="ActionPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">

                    <!-- 1px Vertical Divider -->
                    <Border x:Name="ActionDivider"
                            Width="1" Height="14"
                            Background="#27272A"
                            Margin="6,0,4,0"
                            VerticalAlignment="Center"/>

                    <!-- Home Button (브라우저 열기) -->
                    <Button x:Name="PortalIconButton"
                            Style="{StaticResource ModernIconBtnStyle}"
                            ToolTip="브라우저 열기"
                            Click="OnOpenPortalClick"
                            Margin="0,0,1,0">
                        <Rectangle Width="15" Height="15"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   OpacityMask="{StaticResource BrushIconHome}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <!-- Refresh Button (새로고침) -->
                    <Button x:Name="RefreshIconButton"
                            Style="{StaticResource ModernIconBtnStyle}"
                            ToolTip="새로고침"
                            Click="OnRefreshClick"
                            Margin="0,0,1,0">
                        <Rectangle Width="15" Height="15"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   OpacityMask="{StaticResource BrushIconReboot}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <!-- Settings Button (환경설정) -->
                    <Button x:Name="SettingsIconButton"
                            Style="{StaticResource ModernIconBtnStyle}"
                            ToolTip="환경설정"
                            Click="OnOpenSettingsClick">
                        <Rectangle Width="15" Height="15"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   OpacityMask="{StaticResource BrushIconSettings}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
