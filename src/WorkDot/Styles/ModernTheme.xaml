<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =================================================================== -->
    <!-- SHADCN/UI & TAILWIND ZINC DESIGN SYSTEM (Modern React Style)        -->
    <!-- =================================================================== -->

    <FontFamily x:Key="SansFont">Pretendard, Segoe UI Variable Display, Malgun Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Code, Consolas, Segoe UI</FontFamily>

    <!-- 1. Feather / Lucide Vector Icons (24x24 Coordinate Space, Round Caps & Joins) -->
    <!-- Sun: 근무(중) -->
    <Geometry x:Key="GeomSun">M 12,7 A 5,5 0 1 0 12,17 A 5,5 0 1 0 12,7 Z M 12,1 L 12,3 M 12,21 L 12,23 M 4.22,4.22 L 5.64,5.64 M 18.36,18.36 L 19.78,19.78 M 1,12 L 3,12 M 21,12 L 23,12 M 4.22,19.78 L 5.64,18.36 M 18.36,5.64 L 19.78,4.22</Geometry>
    <!-- Moon: 퇴근 -->
    <Geometry x:Key="GeomMoon">M 21,12.79 A 9,9 0 1 1 11.21,3 A 7,7 0 0 0 21,12.79 Z</Geometry>
    <!-- Paperclip: Snap 상태 표시 -->
    <Geometry x:Key="GeomClip">M 21.44,11.05 L 12.25,20.24 A 6,6 0 0 1 3.76,11.75 L 12.95,2.56 A 4,4 0 0 1 18.61,8.22 L 9.41,17.41 A 2,2 0 0 1 6.58,14.58 L 15.07,6.1</Geometry>
    <Geometry x:Key="GeomSnap">M 21.44,11.05 L 12.25,20.24 A 6,6 0 0 1 3.76,11.75 L 12.95,2.56 A 4,4 0 0 1 18.61,8.22 L 9.41,17.41 A 2,2 0 0 1 6.58,14.58 L 15.07,6.1</Geometry>
